// OpcodeCyclePattern represents the read/write bus activity for each cycle of a 6502 instruction.
// 1 = Read cycle, 0 = Write cycle
// @note This array provides the base cycle patterns. Some instructions (e.g., indexed addressing modes)
// may take additional cycles if a page boundary is crossed. These additional cycles are typically read cycles.
// Illegal opcodes are marked with an asterisk (*). Their behavior and cycle patterns are based on common
// emulation practices and analysis of the original 6502 silicon.

@(rodata)
interrupt_cycle_pattern := []int{1, 1, 0, 0, 0, 1, 1}

@(rodata)
instruction_cycle_pattern := [256][]int{
    // 0x00 - 0x0F
    {1, 1, 0, 0, 0, 1, 1}, // BRK (7 cycles)
    {1, 1, 1, 1, 1, 1}, // ORA (IND,X) (6 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 1, 0, 0}, // *SLO (IND,X) (8 cycles)
    {1, 1, 1}, // *NOP ZP (3 cycles)
    {1, 1, 1}, // ORA ZP (3 cycles)
    {1, 1, 1, 0, 0}, // ASL ZP (5 cycles)
    {1, 1, 1, 0, 0}, // *SLO ZP (5 cycles)
    {1, 1, 0}, // PHP (3 cycles)
    {1, 1}, // ORA IMM (2 cycles)
    {1, 1}, // ASL A (2 cycles)
    {1, 1}, // *ANC IMM (2 cycles)
    {1, 1, 1, 1}, // *NOP ABS (4 cycles)
    {1, 1, 1, 1}, // ORA ABS (4 cycles)
    {1, 1, 1, 1, 0, 0}, // ASL ABS (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *SLO ABS (6 cycles)

    // 0x10 - 0x1F
    {1, 1}, // BPL REL (2 cycles)
    {1, 1, 1, 1, 1}, // ORA (IND),Y (5 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 0, 0, 1}, // *SLO (IND),Y (8 cycles)
    {1, 1, 1, 1}, // *NOP ZP,X (4 cycles)
    {1, 1, 1, 1}, // ORA ZP,X (4 cycles)
    {1, 1, 1, 1, 0, 0}, // ASL ZP,X (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *SLO ZP,X (6 cycles)
    {1, 1}, // CLC (2 cycles)
    {1, 1, 1, 1}, // ORA ABS,Y (4 cycles)
    {1, 1}, // *NOP IMP (2 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *SLO ABS,Y (7 cycles)
    {1, 1, 1, 1}, // *NOP ABS,X (4 cycles)
    {1, 1, 1, 1}, // ORA ABS,X (4 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // ASL ABS,X (7 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *SLO ABS,X (7 cycles)

    // 0x20 - 0x2F
    {1, 1, 1, 0, 0, 1}, // JSR ABS (6 cycles)
    {1, 1, 1, 1, 1, 1}, // AND (IND,X) (6 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 1, 0, 0}, // *RLA (IND,X) (8 cycles)
    {1, 1, 1}, // BIT ZP (3 cycles)
    {1, 1, 1}, // AND ZP (3 cycles)
    {1, 1, 1, 0, 0}, // ROL ZP (5 cycles)
    {1, 1, 1, 0, 0}, // *RLA ZP (5 cycles)
    {1, 1, 1, 1}, // PLP (4 cycles)
    {1, 1}, // AND IMM (2 cycles)
    {1, 1}, // ROL A (2 cycles)
    {1, 1}, // *ANC IMM (2 cycles)
    {1, 1, 1, 1}, // BIT ABS (4 cycles)
    {1, 1, 1, 1}, // AND ABS (4 cycles)
    {1, 1, 1, 1, 0, 0}, // ROL ABS (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *RLA ABS (6 cycles)

    // 0x30 - 0x3F
    {1, 1}, // BMI REL (2 cycles)
    {1, 1, 1, 1, 1}, // AND (IND),Y (5 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 0, 0, 1}, // *RLA (IND),Y (8 cycles)
    {1, 1, 1, 1}, // *NOP ZP,X (4 cycles)
    {1, 1, 1, 1}, // AND ZP,X (4 cycles)
    {1, 1, 1, 1, 0, 0}, // ROL ZP,X (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *RLA ZP,X (6 cycles)
    {1, 1}, // SEC (2 cycles)
    {1, 1, 1, 1}, // AND ABS,Y (4 cycles)
    {1, 1}, // *NOP IMP (2 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *RLA ABS,Y (7 cycles)
    {1, 1, 1, 1}, // *NOP ABS,X (4 cycles)
    {1, 1, 1, 1}, // AND ABS,X (4 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // ROL ABS,X (7 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *RLA ABS,X (7 cycles)

    // 0x40 - 0x4F
    {1, 1, 1, 1, 1, 1}, // RTI (6 cycles)
    {1, 1, 1, 1, 1, 1}, // EOR (IND,X) (6 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 1, 0, 0}, // *SRE (IND,X) (8 cycles)
    {1, 1, 1}, // *NOP ZP (3 cycles)
    {1, 1, 1}, // EOR ZP (3 cycles)
    {1, 1, 1, 0, 0}, // LSR ZP (5 cycles)
    {1, 1, 1, 0, 0}, // *SRE ZP (5 cycles)
    {1, 1, 0}, // PHA (3 cycles)
    {1, 1}, // EOR IMM (2 cycles)
    {1, 1}, // LSR A (2 cycles)
    {1, 1}, // *ALR IMM (2 cycles)
    {1, 1, 1}, // JMP ABS (3 cycles)
    {1, 1, 1, 1}, // EOR ABS (4 cycles)
    {1, 1, 1, 1, 0, 0}, // LSR ABS (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *SRE ABS (6 cycles)

    // 0x50 - 0x5F
    {1, 1}, // BVC REL (2 cycles)
    {1, 1, 1, 1, 1}, // EOR (IND),Y (5 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 0, 0, 1}, // *SRE (IND),Y (8 cycles)
    {1, 1, 1, 1}, // *NOP ZP,X (4 cycles)
    {1, 1, 1, 1}, // EOR ZP,X (4 cycles)
    {1, 1, 1, 1, 0, 0}, // LSR ZP,X (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *SRE ZP,X (6 cycles)
    {1, 1}, // CLI (2 cycles)
    {1, 1, 1, 1}, // EOR ABS,Y (4 cycles)
    {1, 1}, // *NOP IMP (2 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *SRE ABS,Y (7 cycles)
    {1, 1, 1, 1}, // *NOP ABS,X (4 cycles)
    {1, 1, 1, 1}, // EOR ABS,X (4 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // LSR ABS,X (7 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *SRE ABS,X (7 cycles)

    // 0x60 - 0x6F
    {1, 1, 1, 1, 1, 1}, // RTS (6 cycles)
    {1, 1, 1, 1, 1, 1}, // ADC (IND,X) (6 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 1, 0, 0}, // *RRA (IND,X) (8 cycles)
    {1, 1, 1}, // *NOP ZP (3 cycles)
    {1, 1, 1}, // ADC ZP (3 cycles)
    {1, 1, 1, 0, 0}, // ROR ZP (5 cycles)
    {1, 1, 1, 0, 0}, // *RRA ZP (5 cycles)
    {1, 1, 1, 1}, // PLA (4 cycles)
    {1, 1}, // ADC IMM (2 cycles)
    {1, 1}, // ROR A (2 cycles)
    {1, 1}, // *ARR IMM (2 cycles)
    {1, 1, 1, 1, 1}, // JMP IND (5 cycles)
    {1, 1, 1, 1}, // ADC ABS (4 cycles)
    {1, 1, 1, 1, 0, 0}, // ROR ABS (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *RRA ABS (6 cycles)

    // 0x70 - 0x7F
    {1, 1}, // BVS REL (2 cycles)
    {1, 1, 1, 1, 1}, // ADC (IND),Y (5 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 0, 0, 1}, // *RRA (IND),Y (8 cycles)
    {1, 1, 1, 1}, // *NOP ZP,X (4 cycles)
    {1, 1, 1, 1}, // ADC ZP,X (4 cycles)
    {1, 1, 1, 1, 0, 0}, // ROR ZP,X (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *RRA ZP,X (6 cycles)
    {1, 1}, // SEI (2 cycles)
    {1, 1, 1, 1}, // ADC ABS,Y (4 cycles)
    {1, 1}, // *NOP IMP (2 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *RRA ABS,Y (7 cycles)
    {1, 1, 1, 1}, // *NOP ABS,X (4 cycles)
    {1, 1, 1, 1}, // ADC ABS,X (4 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // ROR ABS,X (7 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *RRA ABS,X (7 cycles)

    // 0x80 - 0x8F
    {1, 1}, // *NOP IMM (2 cycles)
    {1, 1, 1, 1, 1, 0}, // STA (IND,X) (6 cycles)
    {1, 1}, // *NOP IMM (2 cycles)
    {1, 1, 1, 1, 1, 0}, // *SAX (IND,X) (6 cycles)
    {1, 1, 0}, // STY ZP (3 cycles)
    {1, 1, 0}, // STA ZP (3 cycles)
    {1, 1, 0}, // STX ZP (3 cycles)
    {1, 1, 0}, // *SAX ZP (3 cycles)
    {1, 1}, // DEY (2 cycles)
    {1, 1}, // *NOP IMM (2 cycles)
    {1, 1}, // TXA (2 cycles)
    {1, 1}, // *XAA IMM (2 cycles, unstable)
    {1, 1, 1, 0}, // STY ABS (4 cycles)
    {1, 1, 1, 0}, // STA ABS (4 cycles)
    {1, 1, 1, 0}, // STX ABS (4 cycles)
    {1, 1, 1, 0}, // *SAX ABS (4 cycles)

    // 0x90 - 0x9F
    {1, 1}, // BCC REL (2 cycles)
    {1, 1, 1, 1, 1, 0}, // STA (IND),Y (6 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 0}, // *SHA (IND),Y (6 cycles, unstable)
    {1, 1, 1, 0}, // STY ZP,X (4 cycles)
    {1, 1, 1, 0}, // STA ZP,X (4 cycles)
    {1, 1, 1, 0}, // STX ZP,Y (4 cycles)
    {1, 1, 1, 0}, // *SAX ZP,Y (4 cycles)
    {1, 1}, // TYA (2 cycles)
    {1, 1, 1, 1, 0}, // STA ABS,Y (5 cycles)
    {1, 1}, // TXS (2 cycles)
    {1, 1, 1, 1, 0}, // *SHY ABS,Y (5 cycles, unstable)
    {1, 1, 1, 1, 0}, // *SHY ABS,X (5 cycles, unstable)
    {1, 1, 1, 1, 0}, // STA ABS,X (5 cycles)
    {1, 1, 1, 1, 0}, // *SHX ABS,Y (5 cycles, unstable)
    {1, 1, 1, 1, 0}, // *SHA ABS,Y (5 cycles, unstable)

    // 0xA0 - 0xAF
    {1, 1}, // LDY IMM (2 cycles)
    {1, 1, 1, 1, 1, 1}, // LDA (IND,X) (6 cycles)
    {1, 1}, // LDX IMM (2 cycles)
    {1, 1, 1, 1, 1, 1}, // *LAX (IND,X) (6 cycles)
    {1, 1, 1}, // LDY ZP (3 cycles)
    {1, 1, 1}, // LDA ZP (3 cycles)
    {1, 1, 1}, // LDX ZP (3 cycles)
    {1, 1, 1}, // *LAX ZP (3 cycles)
    {1, 1}, // TAY (2 cycles)
    {1, 1}, // LDA IMM (2 cycles)
    {1, 1}, // TAX (2 cycles)
    {1, 1}, // *LXA IMM (2 cycles, unstable)
    {1, 1, 1, 1}, // LDY ABS (4 cycles)
    {1, 1, 1, 1}, // LDA ABS (4 cycles)
    {1, 1, 1, 1}, // LDX ABS (4 cycles)
    {1, 1, 1, 1}, // *LAX ABS (4 cycles)

    // 0xB0 - 0xBF
    {1, 1}, // BCS REL (2 cycles)
    {1, 1, 1, 1, 1}, // LDA (IND),Y (5 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1}, // *LAX (IND),Y (5 cycles)
    {1, 1, 1, 1}, // LDY ZP,X (4 cycles)
    {1, 1, 1, 1}, // LDA ZP,X (4 cycles)
    {1, 1, 1, 1}, // LDX ZP,Y (4 cycles)
    {1, 1, 1, 1}, // *LAX ZP,Y (4 cycles)
    {1, 1}, // CLV (2 cycles)
    {1, 1, 1, 1}, // LDA ABS,Y (4 cycles)
    {1, 1}, // TSX (2 cycles)
    {1, 1, 1, 1}, // *LAS ABS,Y (4 cycles, unstable)
    {1, 1, 1, 1}, // LDY ABS,X (4 cycles)
    {1, 1, 1, 1}, // LDA ABS,X (4 cycles)
    {1, 1, 1, 1}, // LDX ABS,Y (4 cycles)
    {1, 1, 1, 1}, // *LAX ABS,Y (4 cycles)

    // 0xC0 - 0xCF
    {1, 1}, // CPY IMM (2 cycles)
    {1, 1, 1, 1, 1, 1}, // CMP (IND,X) (6 cycles)
    {1, 1}, // *NOP IMM (2 cycles)
    {1, 1, 1, 1, 1, 1, 0, 0}, // *DCP (IND,X) (8 cycles)
    {1, 1, 1}, // CPY ZP (3 cycles)
    {1, 1, 1}, // CMP ZP (3 cycles)
    {1, 1, 1, 0, 0}, // DEC ZP (5 cycles)
    {1, 1, 1, 0, 0}, // *DCP ZP (5 cycles)
    {1, 1}, // INY (2 cycles)
    {1, 1}, // CMP IMM (2 cycles)
    {1, 1}, // DEX (2 cycles)
    {1, 1}, // *SBX IMM (2 cycles)
    {1, 1, 1, 1}, // CPY ABS (4 cycles)
    {1, 1, 1, 1}, // CMP ABS (4 cycles)
    {1, 1, 1, 1, 0, 0}, // DEC ABS (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *DCP ABS (6 cycles)

    // 0xD0 - 0xDF
    {1, 1}, // BNE REL (2 cycles)
    {1, 1, 1, 1, 1}, // CMP (IND),Y (5 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 0, 0, 1}, // *DCP (IND),Y (8 cycles)
    {1, 1, 1, 1}, // *NOP ZP,X (4 cycles)
    {1, 1, 1, 1}, // CMP ZP,X (4 cycles)
    {1, 1, 1, 1, 0, 0}, // DEC ZP,X (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *DCP ZP,X (6 cycles)
    {1, 1}, // CLD (2 cycles)
    {1, 1, 1, 1}, // CMP ABS,Y (4 cycles)
    {1, 1}, // *NOP IMP (2 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *DCP ABS,Y (7 cycles)
    {1, 1, 1, 1}, // *NOP ABS,X (4 cycles)
    {1, 1, 1, 1}, // CMP ABS,X (4 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // DEC ABS,X (7 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *DCP ABS,X (7 cycles)

    // 0xE0 - 0xEF
    {1, 1}, // CPX IMM (2 cycles)
    {1, 1, 1, 1, 1, 1}, // SBC (IND,X) (6 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 1, 0, 0}, // *ISC (IND,X) (8 cycles)
    {1, 1, 1}, // CPX ZP (3 cycles)
    {1, 1, 1}, // SBC ZP (3 cycles)
    {1, 1, 1, 0, 0}, // INC ZP (5 cycles)
    {1, 1, 1, 0, 0}, // *ISC ZP (5 cycles)
    {1, 1}, // INX (2 cycles)
    {1, 1}, // SBC IMM (2 cycles)
    {1, 1}, // NOP (2 cycles)
    {1, 1}, // *SBC IMM (2 cycles)
    {1, 1, 1, 1}, // CPX ABS (4 cycles)
    {1, 1, 1, 1}, // SBC ABS (4 cycles)
    {1, 1, 1, 1, 0, 0}, // INC ABS (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *ISC ABS (6 cycles)

    // 0xF0 - 0xFF
    {1, 1}, // BEQ REL (2 cycles)
    {1, 1, 1, 1, 1}, // SBC (IND),Y (5 cycles)
    {1, 1}, // *KIL (2 cycles)
    {1, 1, 1, 1, 1, 0, 0, 1}, // *ISC (IND),Y (8 cycles)
    {1, 1, 1, 1}, // *NOP ZP,X (4 cycles)
    {1, 1, 1, 1}, // SBC ZP,X (4 cycles)
    {1, 1, 1, 1, 0, 0}, // INC ZP,X (6 cycles)
    {1, 1, 1, 1, 0, 0}, // *ISC ZP,X (6 cycles)
    {1, 1}, // SED (2 cycles)
    {1, 1, 1, 1}, // SBC ABS,Y (4 cycles)
    {1, 1}, // *NOP IMP (2 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *ISC ABS,Y (7 cycles)
    {1, 1, 1, 1}, // *NOP ABS,X (4 cycles)
    {1, 1, 1, 1}, // SBC ABS,X (4 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // INC ABS,X (7 cycles)
    {1, 1, 1, 1, 1, 0, 0}, // *ISC ABS,X (7 cycles)
}
